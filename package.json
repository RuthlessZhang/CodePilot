{
  "name": "codepilot",
  "version": "0.2.0",
  "description": "A small, auditable terminal coding agent",
  "type": "module",
  "bin": {
    "codepilot": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "smoke:providers": "tsx src/provider-smoke.ts",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "pyright": "^1.1.411",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  }
}
